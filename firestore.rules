rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() <= 64;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
        'customerName', 'phone', 'address', 'productName',
        'bundleCount', 'quantity', 'totalAmount', 'paymentMethod',
        'status', 'createdAt'
      ]) &&
      data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 50 &&
      data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 25 &&
      data.address is string && data.address.size() >= 1 && data.address.size() <= 200 &&
      (!('detailAddress' in data) || (data.detailAddress is string && data.detailAddress.size() <= 100)) &&
      (!('requestNote' in data) || (data.requestNote is string && data.requestNote.size() <= 100)) &&
      data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 100 &&
      data.bundleCount is int && data.bundleCount >= 1 && data.bundleCount <= 10 &&
      data.quantity is int && data.quantity >= 1 && data.quantity <= 100 &&
      data.totalAmount is int && data.totalAmount >= 0 &&
      data.paymentMethod in ['card', 'kakaopay', 'naverpay', 'vbank', 'tosspay'] &&
      data.status in ['pending', 'paid', 'preparing', 'shipped', 'delivered', 'cancelled'] &&
      data.createdAt is string && data.createdAt.size() <= 50;
    }

    // Orders collection: Anyone can create a new valid order, and read order by ID
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if true;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if isValidId(orderId);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
